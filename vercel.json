{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/exportar-planeador.js": {
      "includeFiles": "api/_plantillas/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
